{
  "extends": "./.orca/types/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "typeRoots": ["./node_modules/@types", "./.orca/types"],
    "types": ["node", "orca", "orca-host", "orca-frame", "orca-worker", "orca-services", "orca-testing"],
    "lib": ["ES2023", "DOM"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "tests/**/*.mts", "scripts/**/*.ts", "playwright.config.ts"]
}
